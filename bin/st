#!/usr/bin/env python3
"""st — the surgical team's control plane.

Deterministic duties that v0.1 gave to LLM roles (the program clerk and
most of the administrator) live here instead: schema-validated records,
atomic IDs, an explicit state machine, worktrees outside the repository,
executable acceptance checks, and signed surgeon actions. `st guard` is the
preToolUse hook (Kiro or Cursor) that enforces authority levels from the
same records.

Standard library only. Requires git and ssh-keygen (OpenSSH >= 8.1).

Agent-side commands:   draft revise dispatch brief report check reclaim
                       journal status show list verify guard
Surgeon-only commands: setup init approve accept reject defer cancel
                       decide grant revoke
Surgeon-only commands sign with the surgeon's key and are refused by the
guard when an agent tries to run them.

This file is a launcher. The implementation is the stdlib-only package in
src/surgical_team/ next to this directory.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "src"))
sys.dont_write_bytecode = True  # never leave __pycache__ in the team checkout

if __name__ == "__main__":
    # `st guard [--role R] [--host H]` runs on every tool call of every agent,
    # so it skips loading the CLI and the command modules (P-1). Same function
    # either way.
    argv = sys.argv[2:]
    if (sys.argv[1:2] == ["guard"] and len(argv) in (2, 4)
            and set(argv[::2]) <= {"--role", "--host"} and len(set(argv[::2])) == len(argv) // 2):
        options = dict(zip(argv[::2], argv[1::2]))
        try:
            from surgical_team.guard.core import guard_main  # noqa: E402
        except Exception as error:  # a broken install must block, not allow
            print(f"surgical-team guard: BLOCKED. guard failed to load, failing closed: "
                  f"{type(error).__name__}: {error}", file=sys.stderr)
            sys.exit(2)
        sys.exit(guard_main(options.get("--role"), options.get("--host", "kiro")))
    from surgical_team.cli import main  # noqa: E402
    sys.exit(main())
