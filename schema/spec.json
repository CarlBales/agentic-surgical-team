{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/the-surgical-team/st/schema/spec.json",
  "title": "Work order spec, as submitted to st draft (input; authority defaults to L0)",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "authority": {
      "enum": [
        "L0",
        "L1",
        "L2"
      ]
    },
    "push": {
      "type": "boolean"
    },
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "in": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "out": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "in"
      ]
    },
    "inputs": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^DEC-\\d{3,}$"
          }
        },
        "orders": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^WO-\\d{8}-\\d{3}$"
          }
        },
        "review": {
          "type": "object",
          "properties": {
            "base": {
              "type": "string"
            },
            "head": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "base",
            "head"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "additionalProperties": false
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "check": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "text"
        ]
      }
    },
    "budget": {
      "type": "object",
      "properties": {
        "minutes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "minutes"
      ]
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^WO-\\d{8}-\\d{3}$"
      }
    },
    "blind": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "standing": {
      "type": "string",
      "pattern": "^DEC-\\d{3,}$"
    },
    "base": {
      "type": "string"
    },
    "check_timeout": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "title",
    "role",
    "intent",
    "scope",
    "acceptance",
    "budget"
  ],
  "$defs": {
    "source": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "tool": {
              "const": "use_aws"
            },
            "service": {
              "type": "string",
              "pattern": "^[a-z0-9-]+$"
            },
            "operations": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "region": {
              "type": "string"
            },
            "profile": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "tool",
            "service",
            "operations"
          ]
        },
        {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "pattern": "^(?:@?[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)?|MCP:[A-Za-z0-9_][A-Za-z0-9_.-]*)$",
              "not": {
                "const": "use_aws"
              }
            },
            "readonly": {
              "const": true
            },
            "note": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "tool",
            "readonly"
          ]
        }
      ]
    }
  }
}
