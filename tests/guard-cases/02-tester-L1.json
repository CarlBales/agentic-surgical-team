      "name": "write in workspace",
      "role": "tester",
      "tool": "write",
      "input": {
        "path": "{ws}/tests/t.rs"
      },
      "cwd": "repo",
      "expect": "allow"
    },
    {
      "name": "write in main checkout",
      "role": "tester",
      "tool": "write",
      "input": {
        "path": "{repo}/src/lib.rs"
      },
      "cwd": "repo",
      "expect": "block"
    },
    {
      "name": "write beside the workspace",
      "role": "tester",
      "tool": "write",
      "input": {
        "path": "{ws}/../elsewhere"
      },
      "cwd": "repo",
      "expect": "block"
    },
