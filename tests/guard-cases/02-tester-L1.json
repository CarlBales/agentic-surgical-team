{
  "about": "A tester holds one live L1 order; an editor order is drafted but not dispatched.",
  "fixture": {
    "orders": [
      {
        "as": "A"
      },
      {
        "as": "E",
        "spec": {
          "role": "editor"
        },
        "approve": false,
        "dispatch": false
      }
    ],
    "symlinks": {
      "{ws:A}/main-link": "{repo}/README.md"
    }
  },
  "cases": [
